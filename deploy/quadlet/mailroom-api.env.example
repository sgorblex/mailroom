# Operator environment for mailroom-api and mailroom-worker. chmod 600.
DATABASE_URL=postgresql://mailroom:change-me@postgres:5432/mailroom
MAILROOM_ENV=production
MAILROOM_DEPLOY_ENV=production
# Seals mailbox passwords: `openssl rand -hex 32`, kept with the database backups' secrets. Without
# it accounts cannot be added or used; with another one their stored passwords no longer open.
MAILROOM_SECRETS_KEY=
# The features this instance runs besides the base (users, sign-in, accounts): any of mail, mcp
# and filters. Unset means all three; set but empty means none; an unknown name stops the API and
# the worker from starting.
# MAILROOM_FEATURES=mail,mcp,filters
# A CA (PEM file, mounted into the container) trusted for mail servers besides the system's.
# MAILROOM_MAIL_CA_FILE=
# MAILROOM_SESSION_TTL_DAYS=14
# MAILROOM_AUDIT_RETENTION_DAYS=365
# MAILROOM_LOG_LEVEL=INFO
# The public origin, e.g. https://mail.example.com (scheme://host, no path): SSO's callback and
# the MCP server's URLs are built from it, never from a request's Host. Unset, SSO and the MCP
# server at /mcp are off; invalid (a path, an invalid host name), it is ignored with a warning. A
# default port (:443) is dropped.
# MAILROOM_PUBLIC_URL=
# Web SSO (OpenID Connect, a confidential client; redirect URI
# MAILROOM_PUBLIC_URL/api/v1/auth/oidc/callback). Off unless issuer, client id and secret are set.
# MAILROOM_OIDC_ISSUER=https://auth.example.com/application/o/mailroom/
# MAILROOM_OIDC_CLIENT_ID=
# MAILROOM_OIDC_CLIENT_SECRET=
# The sign-in button's label.
# MAILROOM_OIDC_NAME=Authentik
# Unset: users link their sign-in on their profile. preferred_username: a first sign-in whose
# preferred_username equals an existing username exactly (case included) links on its own, unless
# that user already has one linked from the provider. Set it only when the provider does not let
# users choose or change their username (an admin sets it), or anyone could claim another's.
# MAILROOM_OIDC_LINK_CLAIM=
# How /mcp checks bearer tokens: builtin, oidc (builtin with sign-in through web SSO only, which
# it needs), external or off; any other value stops the API from starting. Tool groups: default
# the stable ones (docs/requirements/mcp.md).
# MAILROOM_MCP_AUTH=builtin
# MAILROOM_MCP_TOOL_GROUPS=filters_read,filters_write,filters_run,mail_read,mail_organize,mail_folders,mail_draft,mail_send,audit_read
# Built-in OAuth server: https redirect URIs besides claude.ai's, claude.com's and loopback, and
# the hosts whose client ID metadata documents are fetched (empty: none).
# MAILROOM_OAUTH_EXTRA_REDIRECT_URIS=
# MAILROOM_OAUTH_CIMD_HOSTS=claude.ai,claude.com
# External mode (MAILROOM_MCP_AUTH=external): the issuer whose JWTs /mcp accepts (default
# MAILROOM_OIDC_ISSUER), the accepted aud values (required; Authentik's is the client id) and an
# optional scope every token must carry (advertised to clients with openid and offline_access).
# MAILROOM_MCP_OIDC_ISSUER=
# MAILROOM_MCP_OIDC_AUDIENCES=
# MAILROOM_MCP_OIDC_REQUIRED_SCOPE=
