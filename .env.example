# Copy to .env at the repository root for a personal setup. Everything here is optional:
# mise.toml's [env] already carries working dev defaults. A key mise.toml sets (DATABASE_URL,
# TEST_DATABASE_URL, the ports, MAILROOM_SECRETS_KEY, MAILROOM_MAIL_CA_FILE) keeps mise.toml's
# value even if set here: override those in a gitignored mise.local.toml under [env] instead.

# Local PostgreSQL (compose.yml). Published on 127.0.0.1:5434 so other local dev databases
# (5432) and mailroom-mcp's can run at the same time.
# POSTGRES_USER=mailroom
# POSTGRES_PASSWORD=mailroom
# POSTGRES_DB=mailroom
# POSTGRES_PUBLISH_HOST=127.0.0.1
# POSTGRES_PUBLISH_PORT=5434

# Application database (SQLAlchemy URL; a bare postgresql:// is rewritten to psycopg 3).
# DATABASE_URL=postgresql://mailroom:mailroom@127.0.0.1:5434/mailroom
# pytest's database: loopback and a name ending in _test, or the integration tests are skipped
# (MAILROOM_INTEGRATION_TESTS_ALLOW_ANY_DATABASE=1 opts out of that guard).
# TEST_DATABASE_URL=postgresql://mailroom:mailroom@127.0.0.1:5434/mailroom_test
# MAILROOM_DATABASE_POOL_SIZE=5
# MAILROOM_DATABASE_MAX_OVERFLOW=10

# Dev server ports (dev-api, dev-web; the Vite proxy reads both).
# MAILROOM_API_HOST=127.0.0.1
# MAILROOM_API_PORT=8100
# MAILROOM_VITE_PORT=5180

# Sign-in sessions last MAILROOM_SESSION_TTL_DAYS (1-365). Users come from `mise run create-user`.
# MAILROOM_SESSION_TTL_DAYS=14

# Audit records of mail writes are kept MAILROOM_AUDIT_RETENTION_DAYS (1-3650).
# MAILROOM_AUDIT_RETENTION_DAYS=365

# The origin users and MCP clients reach this instance at (an origin only, a valid host, a default
# port dropped; plain http:// on loopback only; anything else is ignored with a warning). Never
# taken from a request's Host. Needed for SSO's callback and the MCP server at /mcp; unset, both
# are off. In dev, the Vite server, opened at this very origin (SSO's browser cookie does not cross
# from 127.0.0.1 to localhost).
# MAILROOM_PUBLIC_URL=http://127.0.0.1:5180

# Web SSO through an OpenID Connect provider (a confidential client whose redirect URI is
# MAILROOM_PUBLIC_URL/api/v1/auth/oidc/callback). Off unless the issuer, client id and secret are set.
# Nobody signs up through it: a user links their sign-in on their profile, or, with
# MAILROOM_OIDC_LINK_CLAIM=preferred_username, the first sign-in whose preferred_username equals a
# username exactly (case included) links on its own: only with a provider whose users cannot
# choose their own username.
# `mise run dev-idp` is a fake provider for these values:
# MAILROOM_OIDC_ISSUER=http://127.0.0.1:8190
# MAILROOM_OIDC_CLIENT_ID=mailroom-dev
# MAILROOM_OIDC_CLIENT_SECRET=mailroom-dev-secret-for-the-fake-provider-only-never-deployed-64
# MAILROOM_OIDC_NAME=Dev IdP
# MAILROOM_OIDC_LINK_CLAIM=
# The fake provider's port (`mise run dev-idp`).
# MAILROOM_DEV_IDP_PORT=8190

# Runtime. `development` switches logs to the human format and drops the session cookie's
# `Secure` flag (the dev server is plain HTTP); the image sets `production`.
# MAILROOM_ENV=development
# MAILROOM_DEPLOY_ENV=development
# MAILROOM_LOG_FORMAT=text
# MAILROOM_LOG_LEVEL=INFO
# Alembic at API startup: the image sets it to 1, and so does mailroom.dev.run_uvicorn when unset.
# The attempts and delay also pace the worker's wait for the database to reach head.
# MAILROOM_RUN_STARTUP_MIGRATIONS=1
# MAILROOM_STARTUP_MIGRATION_MAX_ATTEMPTS=30
# MAILROOM_STARTUP_MIGRATION_RETRY_SECONDS=1

# The features this instance runs besides the base (users, sign-in, accounts): any of mail, mcp
# and filters. Unset means all three; empty means none; an unknown name stops the API and the
# worker from starting.
# MAILROOM_FEATURES=mail,mcp,filters

# Mailbox passwords are sealed under MAILROOM_SECRETS_KEY: 32 random bytes as 64 hex digits
# (`openssl rand -hex 32`). mise.toml sets a dev-only one; losing a deployment's key loses every
# stored password.
# MAILROOM_SECRETS_KEY=
# A CA trusted for mail servers besides the system's: mise.toml points it at the dev mail
# backends' (dev/.state/certs/ca.pem of the checkout that ran `mise run dev-mail`).
# MAILROOM_MAIL_CA_FILE=

# How /mcp checks bearer tokens: builtin (Mailroom's authorization server), external (an OIDC
# provider's JWTs) or off; any other value stops the API from starting. Tool groups
# (docs/requirements/mcp.md): default the stable ones.
# MAILROOM_MCP_AUTH=builtin
# MAILROOM_MCP_TOOL_GROUPS=filters_read,filters_write,filters_run,mail_read,mail_organize,mail_folders,mail_draft,mail_send,audit_read
# The built-in OAuth server (MAILROOM_MCP_AUTH=builtin, MAILROOM_PUBLIC_URL set): https redirect
# URIs allowed besides claude.ai's, claude.com's and loopback, and the hosts whose client ID
# metadata documents are fetched (empty: none). Comma or space separated.
# MAILROOM_OAUTH_EXTRA_REDIRECT_URIS=
# MAILROOM_OAUTH_CIMD_HOSTS=claude.ai,claude.com
# External mode (MAILROOM_MCP_AUTH=external): the provider whose JWTs /mcp accepts (default
# MAILROOM_OIDC_ISSUER), the aud values it accepts (required; comma separated) and an optional
# scope every token must carry (advertised to clients with openid and offline_access). A token's
# (iss, sub) must be a user's linked sign-in; ID tokens are refused.
# `mise run dev-idp` mints tokens for these values:
# MAILROOM_MCP_OIDC_ISSUER=http://127.0.0.1:8190
# MAILROOM_MCP_OIDC_AUDIENCES=mailroom-dev
# MAILROOM_MCP_OIDC_REQUIRED_SCOPE=

# Dev mail backends (scripts/dev-mail.sh, `mise run seed-dev-mail`): the Dovecot users' password.
# DEV_MAIL_PASSWORD=pass

# Image builds (scripts/container-build.sh).
# MAILROOM_CONTAINER_ENGINE=podman
# MAILROOM_REGISTRY=registry.example.org
