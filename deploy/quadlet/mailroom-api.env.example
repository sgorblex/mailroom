# Operator environment for mailroom-api and mailroom-worker. chmod 600.
DATABASE_URL=postgresql://mailroom:change-me@postgres:5432/mailroom
MAILROOM_ENV=production
MAILROOM_DEPLOY_ENV=production
# Seals mailbox passwords: `openssl rand -hex 32`, kept with the database backups' secrets. Without
# it accounts cannot be added or used; with another one their stored passwords no longer open.
MAILROOM_SECRETS_KEY=
# A CA (PEM file, mounted into the container) trusted for mail servers besides the system's.
# MAILROOM_MAIL_CA_FILE=
# MAILROOM_SESSION_TTL_DAYS=14
# MAILROOM_LOG_LEVEL=INFO
