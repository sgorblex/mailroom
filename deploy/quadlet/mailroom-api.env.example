# Operator environment for mailroom-api and mailroom-worker. chmod 600.
DATABASE_URL=postgresql://mailroom:change-me@postgres:5432/mailroom
MAILROOM_ENV=production
MAILROOM_DEPLOY_ENV=production
# Seals mailbox passwords: `openssl rand -hex 32`, kept with the database backups' secrets. Without
# it accounts cannot be added or used; with another one their stored passwords no longer open.
MAILROOM_SECRETS_KEY=
# A CA (PEM file, mounted into the container) trusted for mail servers besides the system's.
# MAILROOM_MAIL_CA_FILE=
# MAILROOM_SESSION_TTL_DAYS=14
# MAILROOM_LOG_LEVEL=INFO
# The public origin, e.g. https://mail.example.com: SSO's callback is built from it, never from a
# request's Host. Unset, SSO is off; invalid (a path, an invalid host name), it is ignored with a
# warning. A default port (:443) is dropped.
# MAILROOM_PUBLIC_URL=
# Web SSO (OpenID Connect, a confidential client; redirect URI
# MAILROOM_PUBLIC_URL/api/v1/auth/oidc/callback). Off unless issuer, client id and secret are set.
# MAILROOM_OIDC_ISSUER=https://auth.example.com/application/o/mailroom/
# MAILROOM_OIDC_CLIENT_ID=
# MAILROOM_OIDC_CLIENT_SECRET=
# The sign-in button's label.
# MAILROOM_OIDC_NAME=Authentik
# Unset: users link their sign-in on their profile. preferred_username: a first sign-in whose
# preferred_username equals an existing username exactly (case included) links on its own, unless
# that user already has one linked from the provider. Set it only when the provider does not let
# users choose or change their username (an admin sets it), or anyone could claim another's.
# MAILROOM_OIDC_LINK_CLAIM=
