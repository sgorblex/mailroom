FROM docker.io/library/python:3.15.0-slim@sha256:f48fda6d59b2b3437781d1c3ccf4aa0e26ae871de3cdd758b49ab45ee7291619 AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_LINK_MODE=copy

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336 /uv /usr/local/bin/uv

COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY backend/README.md README.md
COPY backend/mailroom ./mailroom
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

FROM docker.io/library/python:3.15.0-slim@sha256:f48fda6d59b2b3437781d1c3ccf4aa0e26ae871de3cdd758b49ab45ee7291619 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV MAILROOM_ENV=production
ENV MAILROOM_RUN_STARTUP_MIGRATIONS=1

RUN useradd --create-home --shell /usr/sbin/nologin --uid 1000 mailroom

WORKDIR /app

COPY --from=builder --chown=mailroom:mailroom /app /app

ARG MAILROOM_GIT_SHA=
ENV MAILROOM_GIT_SHA=${MAILROOM_GIT_SHA}

ARG MAILROOM_GIT_BRANCH=
ENV MAILROOM_GIT_BRANCH=${MAILROOM_GIT_BRANCH}

ARG MAILROOM_VERSION=
ARG MAILROOM_BUILD_DATE=
LABEL org.opencontainers.image.title="Mailroom API" \
      org.opencontainers.image.description="Mailroom backend (API and domain logic)" \
      org.opencontainers.image.source="https://github.com/sgorblex/mailroom" \
      org.opencontainers.image.revision="${MAILROOM_GIT_SHA}" \
      org.opencontainers.image.version="${MAILROOM_VERSION}" \
      org.opencontainers.image.created="${MAILROOM_BUILD_DATE}"

# Buildah (as of 1.44.1) can cache-hit a trailing ARG-interpolated ENV/LABEL against a
# stale value from an earlier build with different --build-arg values and no RUN in
# between - this RUN forces the metadata above to actually reflect the current build's
# ARG values instead of silently baking in whatever was cached first. Verified: without
# it, two builds differing only in MAILROOM_GIT_SHA/MAILROOM_VERSION/MAILROOM_BUILD_DATE produced the
# exact same image ID with the first build's stale values.
RUN true

USER mailroom

EXPOSE 8000

# Single worker: MAILROOM_RUN_STARTUP_MIGRATIONS runs Alembic in lifespan — avoid `--workers N>1`
# unless migrations are handled externally so each worker does not race on upgrade head.
CMD [".venv/bin/uvicorn", "mailroom.api.main:application", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--log-level", "info"]
