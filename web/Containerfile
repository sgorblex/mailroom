FROM docker.io/library/node:26.11.1-alpine@sha256:143494b1da2945f061539253adc65e4f1569ddf07da2d384c022c791a9d90a4a AS build

WORKDIR /web

RUN npm install -g pnpm@12.10.1

# pnpm-workspace.yaml is copied so this install runs under the same settings as a host install
# rather than pnpm's defaults. confirmModulesPurge cannot live there — pnpm 12 rejects the file
# over it — and a build never has a TTY to answer the purge prompt with, so it is passed here.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/pnpm-store \
    pnpm install --frozen-lockfile --store-dir=/pnpm-store --config.confirmModulesPurge=false

COPY . .

ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

ARG VITE_MAILROOM_DEPLOY_ENV=
ENV VITE_MAILROOM_DEPLOY_ENV=${VITE_MAILROOM_DEPLOY_ENV}

ARG VITE_GIT_SHA=
ENV VITE_GIT_SHA=${VITE_GIT_SHA}

ARG VITE_GIT_BRANCH=
ENV VITE_GIT_BRANCH=${VITE_GIT_BRANCH}

RUN pnpm run build

FROM docker.io/library/nginx:1.31.6-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2 AS runtime

RUN rm -rf /usr/share/nginx/html/* \
    && sed -i '/user  *nginx;/d; s#/run/nginx.pid#/tmp/nginx.pid#' /etc/nginx/nginx.conf \
    && touch /tmp/nginx.pid \
    && chown -R nginx:nginx /tmp/nginx.pid /var/cache/nginx

COPY nginx-default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html

ARG VITE_GIT_SHA=
ARG VITE_VERSION=
ARG MAILROOM_BUILD_DATE=
LABEL org.opencontainers.image.title="Mailroom Web" \
      org.opencontainers.image.description="Mailroom frontend (React SPA, nginx runtime)" \
      org.opencontainers.image.source="https://github.com/sgorblex/mailroom" \
      org.opencontainers.image.revision="${VITE_GIT_SHA}" \
      org.opencontainers.image.version="${VITE_VERSION}" \
      org.opencontainers.image.created="${MAILROOM_BUILD_DATE}"

# See backend/Containerfile for why this RUN is required - without it, buildah can
# cache-hit this LABEL against a stale value from an earlier build with different
# --build-arg values, silently baking in the wrong revision/version/created.
RUN true

USER nginx

EXPOSE 8080
