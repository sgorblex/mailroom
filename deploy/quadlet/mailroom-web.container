[Unit]
Description=Mailroom web (nginx + static SPA, proxies /api to the API)
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Container]
Image=localhost/mailroom-web:latest
Pod=mailroom.pod

[Service]
Restart=always

[Install]
# For systemctl --user, use default.target instead.
WantedBy=multi-user.target
