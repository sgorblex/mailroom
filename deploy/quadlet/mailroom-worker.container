# Sketch: the worker module does not exist yet; it arrives with the first background feature
# (IMAP IDLE, index, filter runner, learning). Do not install this unit before then.
[Unit]
Description=Mailroom background worker
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Container]
Image=localhost/mailroom-api:production
Label=io.containers.autoupdate=registry
Pod=mailroom.pod
EnvironmentFile=-/etc/mailroom/mailroom-api.env
# The API owns startup migrations; the worker waits for the schema instead.
Environment=MAILROOM_RUN_STARTUP_MIGRATIONS=0
Exec=.venv/bin/python -m mailroom.worker

[Service]
Restart=always

[Install]
# For systemctl --user, use default.target instead.
WantedBy=multi-user.target
