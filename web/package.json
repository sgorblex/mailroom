{
  "name": "mailroom-web",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "pnpm --silent run typecheck && vite build --logLevel warn",
    "lint": "eslint . --max-warnings 0 --quiet",
    "lint:fix": "eslint . --fix --max-warnings 0 --quiet",
    "i18n:check": "i18n-check -l src/locales -s en -f i18next -r summary",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:run": "vitest run --reporter=minimal --silent=passed-only",
    "test:run:node": "vitest run --project node --reporter=minimal --silent=passed-only"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.0",
    "@lingual/i18n-check": "^0.9.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "~1.6.27",
    "eslint": "~10.12.0",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  }
}
